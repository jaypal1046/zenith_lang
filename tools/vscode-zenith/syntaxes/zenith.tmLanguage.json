{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zenith",
  "scopeName": "source.zenith",
  "fileTypes": ["zen"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zenith",
          "match": "//.*$"
        },
        {
          "name": "comment.block.zenith",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zenith",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.zenith",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.zenith",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.zenith",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zenith",
          "match": "\\b(if|else|elif|for|while|return|break|continue|match|case|default|try|catch|throw|import|export|from|as)\\b"
        },
        {
          "name": "keyword.other.zenith",
          "match": "\\b(fn|func|let|var|const|mut|ref|pub|priv|static|extern|foreign|bridge|class|struct|enum|trait|impl|where|type|alias|namespace|module|use|super|self|Self)\\b"
        },
        {
          "name": "keyword.operator.zenith",
          "match": "(=>|->|::|\\?\\.|\\?\\[|\\?\\(|\\|>|<\\||&&|\\|\\||<<|>>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=)"
        },
        {
          "name": "storage.type.zenith",
          "match": "\\b(Int|Float|Double|Bool|String|Char|Void|Null|None|Any|Never|List|Map|Set|Option|Result|Future|Promise)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.zenith",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        },
        {
          "name": "meta.function.zenith",
          "begin": "\\b(fn|func)\\b",
          "end": "(?=\\{|;|$)",
          "patterns": [
            { "include": "#functions" },
            { "include": "#types" },
            { "include": "#identifiers" }
          ]
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.zenith",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "meta.generic.zenith",
          "begin": "<",
          "end": ">",
          "patterns": [
            { "include": "#types" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.zenith",
          "match": "\\b(0[xX][0-9a-fA-F]+|0[bB][01]+|0[oO][0-7]+|\\d+)\\b"
        },
        {
          "name": "constant.numeric.float.zenith",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?[fFdD]?\\b"
        },
        {
          "name": "constant.language.boolean.zenith",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.zenith",
          "match": "\\b(null|none|nil)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.zenith",
          "match": "(\\+|-|\\*|/|%|\\*\\*|\\^)"
        },
        {
          "name": "keyword.operator.comparison.zenith",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.zenith",
          "match": "(=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=)"
        },
        {
          "name": "keyword.operator.logical.zenith",
          "match": "(&&|\\|\\||!|&|\\||\\^|~|<<|>>)"
        },
        {
          "name": "keyword.operator.optional.zenith",
          "match": "(\\?|\\!)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.zenith",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
