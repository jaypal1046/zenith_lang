// Default Layout Component
// Wraps all pages with common structure
// Built with 100% Zenith Code

import 'package:zenith_ui/zenith_ui.dart';
import '../components/navigation.zenith';
import '../components/footer.zenith';

class DefaultLayout extends StatelessWidget {
  final Widget child;
  final String? title;
  
  const DefaultLayout({
    required this.child,
    this.title,
  });
  
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: Navigation(),
      body: Column([
        // Main content
        Expanded(child: child),
        
        // Footer
        Footer(),
      ]),
    );
  }
}

/// Page wrapper with metadata
class PageWrapper extends StatelessWidget {
  final String title;
  final String description;
  final List<String> keywords;
  final Widget child;
  
  const PageWrapper({
    required this.title,
    required this.description,
    this.keywords = const [],
    required this.child,
  });
  
  @override
  Widget build(BuildContext context) {
    return DefaultLayout(
      child: Column([
        // SEO Meta (rendered in head on server)
        _buildMetaTags(),
        
        // Page content
        child,
      ]),
    );
  }
  
  Widget _buildMetaTags() {
    // These would be rendered in <head> during SSR
    return Fragment([
      HtmlElement('title', text: title),
      HtmlElement('meta', attributes: {
        'name': 'description',
        'content': description,
      }),
      if (keywords.isNotEmpty)
        HtmlElement('meta', attributes: {
          'name': 'keywords',
          'content': keywords.join(', '),
        }),
      // Open Graph tags
      HtmlElement('meta', attributes: {
        'property': 'og:title',
        'content': title,
      }),
      HtmlElement('meta', attributes: {
        'property': 'og:description',
        'content': description,
      }),
    ]);
  }
}

/// Error page layout
class ErrorLayout extends StatelessWidget {
  final int statusCode;
  final String message;
  
  const ErrorLayout({
    required this.statusCode,
    required this.message,
  });
  
  @override
  Widget build(BuildContext context) {
    return DefaultLayout(
      child: Container(
        padding: EdgeInsets.all(80),
        child: Column([
          Text(
            '$statusCode',
            style: TextStyle(
              fontSize: 96,
              fontWeight: FontWeight.bold,
              color: Color(0xFF6366F1),
            ),
          ),
          SizedBox(height: 24),
          Text(
            message,
            style: TextStyle(fontSize: 24, color: Colors.grey[600]),
          ),
          SizedBox(height: 32),
          ElevatedButton(
            onPressed: () => Navigator.pushNamed(context, '/'),
            child: Text('Go Home'),
            style: ElevatedButton.styleFrom(
              padding: EdgeInsets.symmetric(horizontal: 32, vertical: 16),
              fontSize: 18,
            ),
          ),
        ]),
      ),
    );
  }
}

/// Loading skeleton for async content
class PageSkeleton extends StatelessWidget {
  final double height;
  
  const PageSkeleton({this.height = 200});
  
  @override
  Widget build(BuildContext context) {
    return Container(
      padding: EdgeInsets.all(40),
      child: Column([
        // Title skeleton
        Container(
          width: double.infinity,
          height: 40,
          decoration: BoxDecoration(
            color: Colors.grey[300],
            borderRadius: BorderRadius.circular(8),
          ),
        ),
        SizedBox(height: 24),
        
        // Content skeletons
        ...List.generate(3, (index) => Padding(
          padding: EdgeInsets.only(bottom: 16),
          child: Container(
            width: double.infinity,
            height: height,
            decoration: BoxDecoration(
              color: Colors.grey[200],
              borderRadius: BorderRadius.circular(8),
            ),
          ),
        )),
      ]),
    );
  }
}
