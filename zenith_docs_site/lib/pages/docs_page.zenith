// Documentation Page - Main documentation landing
// Built with 100% Zenith Code

import 'package:zenith_ui/zenith_ui.dart';
import '../components/navigation.dart';
import '../components/footer.dart';

class DocsPage extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: Navigation(),
      body: SingleChildScrollView(
        child: Column(
          children: [
            _buildHeroSection(),
            _buildQuickStart(),
            _buildDocumentationSections(),
          ],
        ),
      ),
      footer: Footer(),
    );
  }

  Widget _buildHeroSection() {
    return Container(
      padding: EdgeInsets.all(60),
      decoration: BoxDecoration(
        gradient: LinearGradient(
          colors: [Color(0xFF6366F1), Color(0xFF8B5CF6)],
        ),
      ),
      child: Column(
        children: [
          Text(
            'Documentation',
            style: TextStyle(
              fontSize: 48,
              fontWeight: FontWeight.bold,
              color: Colors.white,
            ),
          ),
          SizedBox(height: 16),
          Text(
            'Everything you need to build with Zenith',
            style: TextStyle(
              fontSize: 20,
              color: Colors.white.withOpacity(0.9),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildQuickStart() {
    return Container(
      padding: EdgeInsets.all(60),
      child: Column(
        children: [
          Text(
            'Quick Start',
            style: TextStyle(fontSize: 36, fontWeight: FontWeight.bold),
          ),
          SizedBox(height: 32),
          Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              _buildStepCard('1', 'Install', 'Clone the repository and build'),
              SizedBox(width: 24),
              _buildStepCard('2', 'Write Code', 'Create your first .zen file'),
              SizedBox(width: 24),
              _buildStepCard('3', 'Run', 'Compile and run on any platform'),
            ],
          ),
        ],
      ),
    );
  }

  Widget _buildStepCard(String number, String title, String description) {
    return Card(
      elevation: 2,
      child: Container(
        width: 300,
        padding: EdgeInsets.all(24),
        child: Column(
          children: [
            Container(
              width: 48,
              height: 48,
              decoration: BoxDecoration(
                gradient: LinearGradient(
                  colors: [Color(0xFF6366F1), Color(0xFF8B5CF6)],
                ),
                borderRadius: BorderRadius.circular(24),
              ),
              child: Center(
                child: Text(
                  number,
                  style: TextStyle(
                    color: Colors.white,
                    fontSize: 24,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ),
            ),
            SizedBox(height: 16),
            Text(
              title,
              style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
            ),
            SizedBox(height: 8),
            Text(
              description,
              style: TextStyle(color: Colors.grey[600]),
              textAlign: TextAlign.center,
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildDocumentationSections() {
    return Container(
      padding: EdgeInsets.all(60),
      color: Color(0xFFF8FAFC),
      child: Column(
        children: [
          Text(
            'Documentation Sections',
            style: TextStyle(fontSize: 36, fontWeight: FontWeight.bold),
          ),
          SizedBox(height: 32),
          GridView.count(
            crossAxisCount: 2,
            shrinkWrap: true,
            physics: NeverScrollableScrollPhysics(),
            mainAxisSpacing: 24,
            crossAxisSpacing: 24,
            children: [
              _buildDocCard(
                Icons.menu_book,
                'Getting Started',
                'Installation, setup, and your first program',
              ),
              _buildDocCard(
                Icons.code,
                'Language Guide',
                'Syntax, types, and language features',
              ),
              _buildDocCard(
                Icons.widgets,
                'UI Framework',
                'Building cross-platform user interfaces',
              ),
              _buildDocCard(
                Icons.memory,
                'Memory Management',
                'RC + GC hybrid memory system',
              ),
              _buildDocCard(
                Icons.extension,
                'Package System',
                'Using Rust and Dart packages',
              ),
              _buildDocCard(
                Icons.build,
                'Tooling',
                'Compiler, LSP, and development tools',
              ),
            ],
          ),
        ],
      ),
    );
  }

  Widget _buildDocCard(IconData icon, String title, String description) {
    return Card(
      elevation: 2,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
      child: Padding(
        padding: EdgeInsets.all(24),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Icon(icon, size: 32, color: Color(0xFF6366F1)),
            SizedBox(height: 16),
            Text(
              title,
              style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
            ),
            SizedBox(height: 8),
            Text(
              description,
              style: TextStyle(color: Colors.grey[600], fontSize: 14),
            ),
          ],
        ),
      ),
    );
  }
}
