// Boolean utilities

// Logical AND of multiple values
fn all(values: [Bool]) -> Bool {
    for (value in values) {
        if (!value) {
            return false;
        }
    }
    return true;
}

// Logical OR of multiple values
fn any(values: [Bool]) -> Bool {
    for (value in values) {
        if (value) {
            return true;
        }
    }
    return false;
}

// Negate a boolean value
fn negate(value: Bool) -> Bool {
    return !value;
}

// XOR two boolean values
fn xor(a: Bool, b: Bool) -> Bool {
    return (a && !b) || (!a && b);
}
