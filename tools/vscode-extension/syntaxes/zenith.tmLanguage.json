{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zenith",
  "scopeName": "source.zenith",
  "fileTypes": ["zen"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zenith",
          "match": "//.*$"
        },
        {
          "name": "comment.block.zenith",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zenith",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.zenith",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.zenith",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.zenith",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.zenith",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "constant.numeric.float.zenith",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.hex.zenith",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zenith",
          "match": "\\b(if|else|match|while|for|loop|return|break|continue|yield)\\b"
        },
        {
          "name": "keyword.declaration.zenith",
          "match": "\\b(fn|struct|enum|trait|impl|type|const|static|let|var|mut)\\b"
        },
        {
          "name": "keyword.module.zenith",
          "match": "\\b(module|use|import|export|pub|extern|foreign)\\b"
        },
        {
          "name": "keyword.other.zenith",
          "match": "\\b(true|false|null|self|super|crate)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.zenith",
          "match": "\\b(i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64|bool|char|str|String|Any)\\b"
        },
        {
          "name": "entity.name.type.zenith",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.zenith",
          "match": "\\bfn\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.function.zenith" }
          }
        },
        {
          "name": "meta.function.call.zenith",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "variable.function.zenith" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.zenith",
          "match": "(\\+|-|\\*|/|%|\\*\\*)"
        },
        {
          "name": "keyword.operator.comparison.zenith",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.zenith",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.zenith",
          "match": "(=|\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.bitwise.zenith",
          "match": "(&|\\||\\^|~|<<|>>)"
        },
        {
          "name": "keyword.operator.arrow.zenith",
          "match": "(->|=>)"
        }
      ]
    }
  }
}
