// Test Type Inference
Void main() {
    let x = 5;
    let y = 3.14;
    let name = "Zenith";
    let isActive = true;
    
    // Function with inferred parameters
    Void greet(name = "World") {
        print("Hello, " + name);
    }
    
    greet();
    greet("Developer");
    
    print("x: " + x);
    print("y: " + y);
    print("name: " + name);
    print("isActive: " + isActive);
}
