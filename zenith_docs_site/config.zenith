// Configuration for Zenith Docs Site
// Built with 100% Zenith Code

class SiteConfig {
  static const String title = 'Zenith Language';
  static const String description = 'Build Everything with 100% Zenith Code';
  static const String baseUrl = 'https://docs.zenith.dev';
  static const String outputDir = 'dist';
  
  // Build configuration
  static const BuildConfig build = BuildConfig(
    minify: true,
    sourceMaps: false,
    splitChunks: true,
    outputDir: outputDir,
  );
  
  // Server configuration
  static const ServerConfig server = ServerConfig(
    port: 3000,
    host: 'localhost',
    ssr: true,
    devMode: false,
  );
  
  // Navigation links
  static const List<NavLink> navigation = [
    NavLink(label: 'Docs', path: '/docs'),
    NavLink(label: 'Cookbook', path: '/cookbook'),
    NavLink(label: 'Platforms', path: '/platforms'),
    NavLink(label: 'Packages', path: '/packages'),
  ];
}

class BuildConfig {
  final bool minify;
  final bool sourceMaps;
  final bool splitChunks;
  final String outputDir;
  
  const BuildConfig({
    required this.minify,
    required this.sourceMaps,
    required this.splitChunks,
    required this.outputDir,
  });
}

class ServerConfig {
  final int port;
  final String host;
  final bool ssr;
  final bool devMode;
  
  const ServerConfig({
    required this.port,
    required this.host,
    required this.ssr,
    required this.devMode,
  });
}

class NavLink {
  final String label;
  final String path;
  
  const NavLink({
    required this.label,
    required this.path,
  });
}

// Page metadata interface
class PageMetadata {
  final String title;
  final String description;
  final List<String> keywords;
  final String? ogImage;
  
  const PageMetadata({
    required this.title,
    required this.description,
    this.keywords = const [],
    this.ogImage,
  });
}

// Rendering modes
enum RenderMode {
  ssr,      // Server-Side Rendering
  csr,      // Client-Side Rendering
  static,   // Static Site Generation
  isr,      // Incremental Static Regeneration
}
