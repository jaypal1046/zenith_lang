// Main application entry point for Zenith Documentation Website
// Built with 100% Zenith Code

import 'package:zenith_ui/zenith_ui.dart';
import 'pages/home_page.dart';
import 'pages/cookbook_page.dart';
import 'pages/docs_page.dart';
import 'pages/platforms_page.dart';
import 'pages/packages_page.dart';
import 'components/navigation.dart';
import 'components/footer.dart';

void main() {
  runApp(ZenithDocsApp());
}

class ZenithDocsApp extends App {
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Zenith Language Docs',
      theme: ThemeData(
        primaryColor: Color(0xFF6366F1),
        accentColor: Color(0xFF8B5CF6),
        fontFamily: 'Inter',
        brightness: Brightness.light,
      ),
      darkTheme: ThemeData(
        primaryColor: Color(0xFF4F46E5),
        accentColor: Color(0xFF7C3AED),
        fontFamily: 'Inter',
        brightness: Brightness.dark,
      ),
      themeMode: ThemeMode.system,
      home: HomePage(),
      routes: {
        '/': (context) => HomePage(),
        '/cookbook': (context) => CookbookPage(),
        '/docs': (context) => DocsPage(),
        '/platforms': (context) => PlatformsPage(),
        '/packages': (context) => PackagesPage(),
      },
    );
  }
}
