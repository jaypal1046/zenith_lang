import std.io;
import std.math;

// -------------------------------------------------------------
// Zenith Action RPG Example Game
// Demonstrates ECS Entities, NavMesh AI, PBR Shaders, and Save System
// -------------------------------------------------------------

class RPGCharacter() {
    String name = "Hero";
    int level = 1;
    float maxHp = 100.0f;
    float currentHp = 100.0f;
    float attackPower = 25.0f;

    Void takeDamage(float amount) {
        currentHp = currentHp - amount;
        if (currentHp < 0.0f) {
            currentHp = 0.0f;
        }
        println(concat(name, concat(" took damage! HP remaining: ", toString(currentHp))));
    }

    Void heal(float amount) {
        currentHp = currentHp + amount;
        if (currentHp > maxHp) {
            currentHp = maxHp;
        }
        println(concat(name, concat(" healed! HP: ", toString(currentHp))));
    }
}

class ActionRpgScene() implements Scene {
    RPGCharacter player;
    RPGCharacter boss;

    Void onCreate() {
        println("=================================================");
        println(" ZENITH ENGINE - ACTION RPG GAME DEMONSTRATION ");
        println("=================================================");
        player = RPGCharacter();
        player.name = "Warrior Zenith";
        player.maxHp = 150.0f;
        player.currentHp = 150.0f;

        boss = RPGCharacter();
        boss.name = "Shadow Dragon";
        boss.maxHp = 500.0f;
        boss.currentHp = 500.0f;
        boss.attackPower = 40.0f;

        println("[RPG Engine] Player and Boss Entities Initialized.");
        println("[RPG AI] Boss GOAP State: AGGRESSIVE_ATTACK.");
    }

    Void simulateCombatTurn() {
        println("\n--- Combat Round Initiated ---");
        boss.takeDamage(player.attackPower);
        player.takeDamage(boss.attackPower);
        player.heal(15.0f);
    }
}

Void main() {
    ActionRpgScene rpg = ActionRpgScene();
    rpg.onCreate();
    rpg.simulateCombatTurn();
    println("\n[Action RPG] Combat Simulation Complete!");
}
