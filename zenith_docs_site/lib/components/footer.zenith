// Footer Component - Modern footer with links and branding
// Built with 100% Zenith Code

import 'package:zenith_ui/zenith_ui.dart';

class Footer extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return Container(
      color: Color(0xFF0F172A),
      padding: EdgeInsets.all(60),
      child: Column(
        children: [
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Row(
                      children: [
                        Container(
                          width: 40,
                          height: 40,
                          decoration: BoxDecoration(
                            gradient: LinearGradient(
                              colors: [Color(0xFF6366F1), Color(0xFF8B5CF6)],
                            ),
                            borderRadius: BorderRadius.circular(8),
                          ),
                          child: Center(
                            child: Text(
                              'Z',
                              style: TextStyle(
                                color: Colors.white,
                                fontSize: 24,
                                fontWeight: FontWeight.bold,
                              ),
                            ),
                          ),
                        ),
                        SizedBox(width: 12),
                        Text(
                          'Zenith Language',
                          style: TextStyle(
                            color: Colors.white,
                            fontSize: 20,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                      ],
                    ),
                    SizedBox(height: 16),
                    Text(
                      'Build Everything with 100% Zenith Code',
                      style: TextStyle(
                        color: Colors.white.withOpacity(0.7),
                        fontSize: 14,
                      ),
                    ),
                    SizedBox(height: 24),
                    Row(
                      children: [
                        _buildSocialIcon(Icons.code),
                        SizedBox(width: 12),
                        _buildSocialIcon(Icons.book),
                        SizedBox(width: 12),
                        _buildSocialIcon(Icons.people),
                        SizedBox(width: 12),
                        _buildSocialIcon(Icons.alternate_email),
                      ],
                    ),
                  ],
                ),
              ),
              SizedBox(width: 40),
              _buildFooterColumn(
                'Product',
                ['Features', 'Documentation', 'Cookbook', 'Examples'],
              ),
              SizedBox(width: 40),
              _buildFooterColumn(
                'Resources',
                ['Getting Started', 'API Reference', 'Community', 'Blog'],
              ),
              SizedBox(width: 40),
              _buildFooterColumn(
                'Company',
                ['About', 'Careers', 'Legal', 'Contact'],
              ),
            ],
          ),
          Divider(color: Colors.white.withOpacity(0.1), height: 48),
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Text(
                '© 2024 Zenith Language. All rights reserved.',
                style: TextStyle(color: Colors.white.withOpacity(0.5)),
              ),
              Row(
                children: [
                  TextButton(
                    onPressed: () {},
                    child: Text(
                      'Privacy Policy',
                      style: TextStyle(color: Colors.white.withOpacity(0.5)),
                    ),
                  ),
                  SizedBox(width: 8),
                  TextButton(
                    onPressed: () {},
                    child: Text(
                      'Terms of Service',
                      style: TextStyle(color: Colors.white.withOpacity(0.5)),
                    ),
                  ),
                ],
              ),
            ],
          ),
        ],
      ),
    );
  }

  Widget _buildSocialIcon(IconData icon) {
    return Container(
      width: 40,
      height: 40,
      decoration: BoxDecoration(
        color: Colors.white.withOpacity(0.1),
        borderRadius: BorderRadius.circular(8),
      ),
      child: Icon(icon, color: Colors.white.withOpacity(0.7), size: 20),
    );
  }

  Widget _buildFooterColumn(String title, List<String> links) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(
          title,
          style: TextStyle(
            color: Colors.white,
            fontSize: 16,
            fontWeight: FontWeight-semibold,
          ),
        ),
        SizedBox(height: 16),
        ...links.map((link) => Padding(
          padding: EdgeInsets.only(bottom: 12),
          child: TextButton(
            onPressed: () {},
            child: Text(
              link,
              style: TextStyle(
                color: Colors.white.withOpacity(0.7),
                fontSize: 14,
              ),
            ),
            style: TextButton.styleFrom(padding: EdgeInsets.zero),
          ),
        )).toList(),
      ],
    );
  }
}
