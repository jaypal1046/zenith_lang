// pages/index.zen - Home page
import std.io;

class HomePage() {
    String title = "Zenith App";
    String tagline = "Built with Zenith — the compiler that competes with Next.js";

    UI build() {
        return Column(
            Text(title, fontWeight: "bold", color: "cyan"),
            Text(tagline, color: "gray"),
            Row(
                Card(
                    Text("Pages Router", fontWeight: "bold"),
                    Text("File-system routing like Next.js", color: "green"),
                    Button("Go to About", onClick: goAbout),
                    padding: 2
                ),
                Card(
                    Text("Hot Reload", fontWeight: "bold"),
                    Text("Edit .zen files and browser auto-refreshes", color: "magenta"),
                    padding: 2
                ),
                Card(
                    Text("Static Assets", fontWeight: "bold"),
                    Text("Serve files from public/ with correct MIME types", color: "yellow"),
                    padding: 2
                )
            )
        );
    }

    Void goAbout() {
        println("Navigating to /about");
    }
}

Void main() {
    println("[SSR] Rendered: index");
}
