{
  "name": "vscode-zenith",
  "displayName": "Zenith Language Support",
  "description": "Syntax highlighting and LSP integration for the Zenith programming language",
  "version": "0.1.0",
  "publisher": "zenith-lang",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:zenith",
    "workspaceContains:**/*.zen"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "zenith",
        "aliases": ["Zenith", "zenith"],
        "extensions": [".zen"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/zenith-icon-light.png",
          "dark": "./icons/zenith-icon-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "zenith",
        "scopeName": "source.zenith",
        "path": "./syntaxes/zenith.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "zenith.startLSP",
        "title": "Zenith: Start Language Server",
        "category": "Zenith"
      },
      {
        "command": "zenith.restartLSP",
        "title": "Zenith: Restart Language Server",
        "category": "Zenith"
      },
      {
        "command": "zenith.stopLSP",
        "title": "Zenith: Stop Language Server",
        "category": "Zenith"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == zenith",
          "command": "zenith.startLSP",
          "group": "zenith@1"
        }
      ]
    },
    "configuration": {
      "title": "Zenith Language",
      "properties": {
        "zenith.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the Zenith LSP daemon executable (leave empty for auto-detection)"
        },
        "zenith.lsp.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the LSP server when opening a Zenith file"
        },
        "zenith.compiler.path": {
          "type": "string",
          "default": "zenith",
          "description": "Path to the Zenith compiler executable"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
