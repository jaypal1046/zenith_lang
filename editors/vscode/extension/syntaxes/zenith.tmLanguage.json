{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zenith",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#function-declarations"
    },
    {
      "include": "#function-calls"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zenith",
          "match": "//.*$"
        },
        {
          "name": "comment.block.zenith",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zenith",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.zenith",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zenith",
          "match": "\\b(if|else|while|for|return|match|await|async|try|catch|setState)\\b"
        },
        {
          "name": "keyword.other.zenith",
          "match": "\\b(class|interface|import|foreign|orchestration|agentic|mode|agents|prompt|streaming|multimodal)\\b"
        },
        {
          "name": "constant.language.boolean.zenith",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.zenith",
          "match": "\\b(Int|Float|String|Bool|Void|List|Map|Future|Option|Result|Some|None|Ok|Err)\\b"
        },
        {
          "name": "support.class.zenith",
          "match": "\\b(Column|Row|Text|Button|Card|Container|TextField|Image|Video|Scrolling|Checkbox|Slider|Toggle|Dropdown)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.zenith",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.zenith",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "entity.name.type.annotation.zenith",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "support.type.zenith"
            },
            "2": {
              "name": "entity.name.function.zenith"
            }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.zenith",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    }
  },
  "scopeName": "source.zenith"
}
