// Home Page - Main landing page for Zenith Documentation
// File-based routing: / (index)
// Built with 100% Zenith Code

import 'package:zenith_ui/zenith_ui.dart';
import '../layouts/default.zenith';
import '../components/Hero.zenith';
import '../components/PlatformShowcase.zenith';
import '../components/FeatureGrid.zenith';
import '../components/CodeDemo.zenith';

export const renderMode = 'ssr';
export const metadata = {
  title: 'Zenith Language - Official Documentation',
  description: 'Build Everything with 100% Zenith Code - Games, Mobile, Desktop, Web, WebAssembly',
  keywords: ['zenith', 'programming language', 'cross-platform', 'dart', 'rust', 'webassembly'],
};

/// Server-side data fetching
Future<Map<String, dynamic>> getServerSideProps(context) async {
  // Fetch latest stats, features, etc.
  final features = await _fetchFeatures();
  return {'props': {'features': features}};
}

Future<List<Map<String, String>>> _fetchFeatures() async {
  // In production, fetch from API or database
  return [
    {'icon': '⚡', 'title': 'Lightning Fast', 'desc': 'Native performance on all platforms'},
    {'icon': '🎯', 'title': 'Type Safe', 'desc': 'Catch errors at compile time'},
    {'icon': '🔄', 'title': 'Hot Reload', 'desc': 'See changes instantly'},
    {'icon': '📦', 'title': 'Rich Ecosystem', 'desc': 'Access Rust and Dart packages'},
    {'icon': '🌐', 'title': 'Cross-Platform', 'desc': 'Write once, run everywhere'},
    {'icon': '🛠️', 'title': 'Great Tooling', 'desc': 'LSP, debugger, and more'},
  ];
}

class HomePage extends StatelessWidget {
  final List<Map<String, String>> features;
  
  const HomePage({required this.features});
  
  @override
  Widget build(BuildContext context) {
    return DefaultLayout(
      child: Column([
        // Hero Section
        Hero(
          title: 'Zenith Language',
          subtitle: 'Build Everything with 100% Zenith Code',
          tagline: 'Games • Mobile • Desktop • Web • WebAssembly',
          ctas: [
            CTAButton(text: 'Get Started', href: '/docs', variant: 'primary'),
            CTAButton(text: 'View Cookbook', href: '/cookbook', variant: 'outline'),
          ],
        ),
        
        // Platform Showcase
        PlatformShowcase(),
        
        // Feature Grid
        FeatureGrid(features: features),
        
        // Code Demo
        CodeDemo(
          title: 'Simple & Powerful',
          description: 'Clean syntax with modern features',
          code: '''
// Hello World in Zenith
void main() {
  print('Hello, Zenith!');
}

// Cross-platform UI
class MyApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      home: Scaffold(
        appBar: AppBar(title: Text('Zenith App')),
        body: Center(child: Text('Works everywhere!')),
      ),
    );
  }
}

// Async/Await
Future<void> fetchData() async {
  final response = await http.get('/api/data');
  print(response.body);
}''',
        ),
        
        // Cookbook Preview
        _buildCookbookPreview(context),
        
        // Packages Section
        _buildPackagesSection(context),
        
        // CTA Section
        _buildCTASection(context),
      ]),
    );
  }
  
  Widget _buildCookbookPreview(BuildContext context) {
    return Container(
      padding: EdgeInsets.all(60),
      child: Column([
        Text(
          'Cookbook',
          style: TextStyle(fontSize: 42, fontWeight: FontWeight.bold),
        ),
        SizedBox(height: 16),
        Text(
          'Learn by building real applications',
          style: TextStyle(fontSize: 20, color: Colors.grey[600]),
        ),
        SizedBox(height: 40),
        GridView.count(
          crossAxisCount: 3,
          shrinkWrap: true,
          physics: NeverScrollableScrollPhysics(),
          children: [
            _cookbookItem('🎮', 'Game Dev', 'Snake, Tic-Tac-Toe'),
            _cookbookItem('📱', 'Mobile Apps', 'iOS & Android'),
            _cookbookItem('🖥️', 'Desktop', 'Windows, Mac, Linux'),
            _cookbookItem('🌐', 'Web Apps', 'SPA & PWA'),
            _cookbookItem('🦀', 'Rust Bridge', 'Use Rust crates'),
            _cookbookItem('🎯', 'Dart Packages', 'Full Dart access'),
          ],
        ),
        SizedBox(height: 32),
        ElevatedButton(
          onPressed: () => Navigator.pushNamed(context, '/cookbook'),
          child: Text('Explore Full Cookbook'),
          style: ElevatedButton.styleFrom(
            padding: EdgeInsets.symmetric(horizontal: 32, vertical: 16),
            fontSize: 18,
          ),
        ),
      ]),
    );
  }
  
  Widget _cookbookItem(String emoji, String title, String desc) {
    return Card(
      margin: EdgeInsets.all(16),
      child: Padding(
        padding: EdgeInsets.all(20),
        child: Column([
          Text(emoji, style: TextStyle(fontSize: 48)),
          SizedBox(height: 12),
          Text(title, style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
          SizedBox(height: 8),
          Text(desc, style: TextStyle(color: Colors.grey[600], textAlign: TextAlign.center)),
        ]),
      ),
    );
  }
  
  Widget _buildPackagesSection(BuildContext context) {
    return Container(
      padding: EdgeInsets.all(60),
      color: Color(0xFFF8FAFC),
      child: Column([
        Text(
          'Package Ecosystem',
          style: TextStyle(fontSize: 42, fontWeight: FontWeight.bold),
        ),
        SizedBox(height: 16),
        Text(
          'Leverage existing ecosystems with seamless bridges',
          style: TextStyle(fontSize: 20, color: Colors.grey[600]),
        ),
        SizedBox(height: 40),
        Row(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            _packageCard(
              '🦀', 'Rust', 'zenith_rust',
              'Access thousands of Rust crates',
              ['Zero-copy FFI', 'Async support', 'Type-safe'],
            ),
            SizedBox(width: 24),
            _packageCard(
              '🎯', 'Dart', 'zenith_dart',
              'Use Dart packages seamlessly',
              ['Auto-bindings', 'Hot reload', 'Null safety'],
            ),
          ],
        ),
        SizedBox(height: 32),
        ElevatedButton(
          onPressed: () => Navigator.pushNamed(context, '/packages'),
          child: Text('Learn About Package Integration'),
          style: ElevatedButton.styleFrom(
            padding: EdgeInsets.symmetric(horizontal: 32, vertical: 16),
            fontSize: 18,
          ),
        ),
      ]),
    );
  }
  
  Widget _packageCard(String emoji, String title, String pkg, String desc, List<String> features) {
    return Card(
      elevation: 4,
      child: Container(
        width: 400,
        padding: EdgeInsets.all(24),
        child: Column([
          Row([
            Text(emoji, style: TextStyle(fontSize: 36)),
            SizedBox(width: 12),
            Column([
              Text(title, style: TextStyle(fontSize: 24, fontWeight: FontWeight.bold)),
              Text(pkg, style: TextStyle(color: Colors.blue, fontSize: 14)),
            ]),
          ]),
          SizedBox(height: 16),
          Text(desc, style: TextStyle(color: Colors.grey[700])),
          SizedBox(height: 16),
          ...features.map((f) => Padding(
            padding: EdgeInsets.only(bottom: 8),
            child: Row([
              Icon(Icons.check, color: Colors.green, size: 18),
              SizedBox(width: 8),
              Text(f),
            ]),
          )),
        ]),
      ),
    );
  }
  
  Widget _buildCTASection(BuildContext context) {
    return Container(
      padding: EdgeInsets.all(80),
      decoration: BoxDecoration(
        gradient: LinearGradient(colors: [Color(0xFF6366F1), Color(0xFF8B5CF6)]),
      ),
      child: Column([
        Text(
          'Ready to Start Building?',
          style: TextStyle(fontSize: 36, fontWeight: FontWeight.bold, color: Colors.white),
        ),
        SizedBox(height: 16),
        Text(
          'Join thousands of developers building with Zenith',
          style: TextStyle(fontSize: 18, color: Colors.white70),
        ),
        SizedBox(height: 32),
        Row(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            ElevatedButton(
              onPressed: () => Navigator.pushNamed(context, '/docs'),
              child: Text('Read Documentation'),
              style: ElevatedButton.styleFrom(
                backgroundColor: Colors.white,
                foregroundColor: Color(0xFF6366F1),
                padding: EdgeInsets.symmetric(horizontal: 32, vertical: 16),
                fontSize: 18,
              ),
            ),
            SizedBox(width: 16),
            OutlinedButton(
              onPressed: () {},
              child: Text('Star on GitHub'),
              style: OutlinedButton.styleFrom(
                foregroundColor: Colors.white,
                padding: EdgeInsets.symmetric(horizontal: 32, vertical: 16),
                fontSize: 18,
                side: BorderSide(color: Colors.white, width: 2),
              ),
            ),
          ],
        ),
      ]),
    );
  }
}
