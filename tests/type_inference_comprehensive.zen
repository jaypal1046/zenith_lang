// Test 1: Basic variable inference
let x = 42
let y = 3.14
let name = "Zenith"
let active = true

// Test 2: Explicit types still work
let count: Int = 100
let price: Float = 9.99

// Test 3: Function with inferred parameters
Void greet(name = "World") {
    print("Hello, " + name)
}

// Test 4: Function with mixed inferred and explicit
Void add(a, b: Int) {
    let result = a + b
    print(result)
}

// Test 5: Array inference
let numbers = [1, 2, 3]
let fruits = ["apple", "banana"]

// Test 6: Object inference
let config = {
    debug: true,
    version: "1.0"
}

// Execute tests
print("x = " + x)
print("y = " + y)
print("name = " + name)
print("active = " + active)
print("count = " + count)
greet()
greet("Developer")
