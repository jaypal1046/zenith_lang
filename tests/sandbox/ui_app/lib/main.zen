// Zenith WebAssembly Showcase Website
import std.io;

class ShowcaseSite() {
    String title = "ZENITH NATIVE WASM ENGINE";
    String subtitle = "Running purely inside the browser sandbox";
    String description = "No Javascript VMs. No Garbage Collector Pauses. Pure Systems Performance.";
    Int clicks = 0;
    
    UI build() {
        return Column(
            Text(title),
            Text(description),
            Row(
                Text("Status: "),
                Text(subtitle)
            ),
            Row(
                Text("Total Clicks: " + clicks),
                Button("Increment Clicks", onClick: increment)
            )
        );
    }
    
    Void increment() {
        setState {
            clicks = clicks + 1;
        }
    }
}

Void main() {
    println("--- Booting WASM Zenith App ---");
    
    ShowcaseSite site = ShowcaseSite();
    site.build().render();
    
    println("--- UI DOM Rendered Successfully from WASM! ---");
}
