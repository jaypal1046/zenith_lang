import "../lib/aes_vault/main.zen";
import "../lib/key_derive/main.zen";
import std.io;

class VaultService() {

    String masterKey = "";

    Void unlock(String password) {
        String salt = "zenith_securevault_salt";
        masterKey = deriveKey(password, salt);   // Dart bridge
    }

    String save(String noteText) {
        return encrypt(noteText, masterKey);      // Rust bridge
    }

    String open(String cipherText) {
        return decrypt(cipherText, masterKey);    // Rust bridge
    }

    agentic String summarize(String noteText) {
        prompt: "Summarize this note in 2 sentences: {noteText}"
        streaming: true
    }
}
