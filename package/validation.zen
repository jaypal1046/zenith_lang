// Zenith Validation Module
// Data validation and sanitization utilities

module package.validation;

// Email Validation

/// Validate email format
pub fn is_email(value: string) -> bool {
    if value.length() < 5 || value.length() > 254 {
        return false;
    }
    
    var at_count: int = 0;
    var dot_after_at: bool = false;
    var has_dot: bool = false;
    
    for i in 0..value.length() {
        var c: string = value.char_at(i);
        
        if c == "@" {
            at_count = at_count + 1;
            if at_count > 1 {
                return false;
            }
        } else if c == "." && at_count > 0 {
            has_dot = true;
            dot_after_at = true;
        } else if at_count == 0 {
            // Before @
            if !is_alphanumeric_or_allowed(c) {
                return false;
            }
        } else {
            // After @
            if !is_alphanumeric_or_dot_hyphen(c) {
                return false;
            }
        }
    }
    
    return at_count == 1 && has_dot && dot_after_at;
}

// URL Validation

/// Validate URL format
pub fn is_url(value: string) -> bool {
    if value.length() < 8 {
        return false;
    }
    
    // Check protocol
    if !string::starts_with(value, "http://") && 
       !string::starts_with(value, "https://") &&
       !string::starts_with(value, "ftp://") {
        return false;
    }
    
    // Basic structure check
    var has_dot: bool = false;
    var after_protocol: bool = false;
    
    for i in 0..value.length() {
        var c: string = value.char_at(i);
        
        if string::starts_with(string::substring(value, i, i + 7), "://") {
            after_protocol = true;
            continue;
        }
        
        if after_protocol && c == "." {
            has_dot = true;
        }
        
        if after_protocol && (c == "/" || c == "?" || c == "#") {
            break;
        }
    }
    
    return has_dot;
}

// IP Address Validation

/// Validate IPv4 address
pub fn is_ipv4(value: string) -> bool {
    var parts: [string] = string::split(value, ".");
    if parts.length() != 4 {
        return false;
    }
    
    for part in parts {
        if part.length() == 0 || part.length() > 3 {
            return false;
        }
        
        // Check if all characters are digits
        for i in 0..part.length() {
            if !is_digit(part.char_at(i)) {
                return false;
            }
        }
        
        var num: int = string::to_int(part);
        if num < 0 || num > 255 {
            return false;
        }
        
        // Check for leading zeros
        if part.length() > 1 && part.char_at(0) == "0" {
            return false;
        }
    }
    
    return true;
}

/// Validate IPv6 address (simplified)
pub fn is_ipv6(value: string) -> bool {
    var parts: [string] = string::split(value, ":");
    if parts.length() < 2 || parts.length() > 8 {
        return false;
    }
    
    for part in parts {
        if part.length() == 0 || part.length() > 4 {
            return false;
        }
        
        for i in 0..part.length() {
            var c: string = part.char_at(i);
            if !is_hex_digit(c) {
                return false;
            }
        }
    }
    
    return true;
}

/// Validate IP address (IPv4 or IPv6)
pub fn is_ip(value: string) -> bool {
    return is_ipv4(value) || is_ipv6(value);
}

// Phone Number Validation

/// Validate phone number (international format)
pub fn is_phone(value: string) -> bool {
    // Remove common separators
    var cleaned: string = "";
    for i in 0..value.length() {
        var c: string = value.char_at(i);
        if is_digit(c) || c == "+" {
            cleaned = cleaned + c;
        }
    }
    
    // Check length and format
    if cleaned.length() < 7 || cleaned.length() > 15 {
        return false;
    }
    
    // Must start with + or digit
    var first: string = cleaned.char_at(0);
    if first != "+" && !is_digit(first) {
        return false;
    }
    
    // Rest must be digits
    for i in 1..cleaned.length() {
        if !is_digit(cleaned.char_at(i)) {
            return false;
        }
    }
    
    return true;
}

// Credit Card Validation

/// Validate credit card number using Luhn algorithm
pub fn is_credit_card(value: string) -> bool {
    // Remove spaces and dashes
    var cleaned: string = "";
    for i in 0..value.length() {
        var c: string = value.char_at(i);
        if is_digit(c) {
            cleaned = cleaned + c;
        }
    }
    
    if cleaned.length() < 13 || cleaned.length() > 19 {
        return false;
    }
    
    // Luhn algorithm
    var sum: int = 0;
    var is_second: bool = false;
    
    for i in (cleaned.length() - 1)..-1 {
        var digit: int = string::to_int(string::from_char(cleaned.char_at(i)));
        
        if is_second {
            digit = digit * 2;
            if digit > 9 {
                digit = digit - 9;
            }
        }
        
        sum = sum + digit;
        is_second = !is_second;
    }
    
    return sum % 10 == 0;
}

/// Get card type
pub fn get_card_type(value: string) -> string {
    var cleaned: string = "";
    for i in 0..value.length() {
        var c: string = value.char_at(i);
        if is_digit(c) {
            cleaned = cleaned + c;
        }
    }
    
    if string::starts_with(cleaned, "4") {
        return "Visa";
    } else if string::starts_with(cleaned, "5") {
        return "MasterCard";
    } else if string::starts_with(cleaned, "34") || string::starts_with(cleaned, "37") {
        return "American Express";
    } else if string::starts_with(cleaned, "6") {
        return "Discover";
    } else if string::starts_with(cleaned, "300") || string::starts_with(cleaned, "301") ||
              string::starts_with(cleaned, "302") || string::starts_with(cleaned, "303") ||
              string::starts_with(cleaned, "304") || string::starts_with(cleaned, "305") {
        return "Diners Club";
    } else if string::starts_with(cleaned, "35") {
        return "JCB";
    }
    
    return "Unknown";
}

// String Validation

/// Check if string is alphanumeric
pub fn is_alphanumeric(value: string) -> bool {
    if value.length() == 0 {
        return false;
    }
    for i in 0..value.length() {
        if !is_alphanumeric_char(value.char_at(i)) {
            return false;
        }
    }
    return true;
}

/// Check if string is alphabetic
pub fn is_alpha(value: string) -> bool {
    if value.length() == 0 {
        return false;
    }
    for i in 0..value.length() {
        if !is_letter(value.char_at(i)) {
            return false;
        }
    }
    return true;
}

/// Check if string is numeric
pub fn is_numeric(value: string) -> bool {
    if value.length() == 0 {
        return false;
    }
    for i in 0..value.length() {
        if !is_digit(value.char_at(i)) && value.char_at(i) != "." && value.char_at(i) != "-" {
            return false;
        }
    }
    return true;
}

/// Check if string is integer
pub fn is_integer(value: string) -> bool {
    if value.length() == 0 {
        return false;
    }
    for i in 0..value.length() {
        if !is_digit(value.char_at(i)) && value.char_at(i) != "-" {
            return false;
        }
    }
    return true;
}

/// Check if string is boolean
pub fn is_boolean(value: string) -> bool {
    var lower: string = string::to_lower(value);
    return lower == "true" || lower == "false" || lower == "1" || lower == "0";
}

/// Check if string matches pattern
pub fn matches_pattern(value: string, pattern: string) -> bool {
    // Simple pattern matching (* = any chars, ? = single char)
    var vi: int = 0;
    var pi: int = 0;
    var star_idx: int = -1;
    var match_idx: int = 0;
    
    while vi < value.length() {
        if pi < pattern.length() && (pattern.char_at(pi) == "?" || pattern.char_at(pi) == value.char_at(vi)) {
            vi = vi + 1;
            pi = pi + 1;
        } else if pi < pattern.length() && pattern.char_at(pi) == "*" {
            star_idx = pi;
            match_idx = vi;
            pi = pi + 1;
        } else if star_idx >= 0 {
            pi = star_idx + 1;
            match_idx = match_idx + 1;
            vi = match_idx;
        } else {
            return false;
        }
    }
    
    while pi < pattern.length() && pattern.char_at(pi) == "*" {
        pi = pi + 1;
    }
    
    return pi == pattern.length();
}

// Length Validation

/// Check minimum length
pub fn min_length(value: string, min: int) -> bool {
    return value.length() >= min;
}

/// Check maximum length
pub fn max_length(value: string, max: int) -> bool {
    return value.length() <= max;
}

/// Check exact length
pub fn exact_length(value: string, length: int) -> bool {
    return value.length() == length;
}

/// Check length range
pub fn length_between(value: string, min: int, max: int) -> bool {
    var len: int = value.length();
    return len >= min && len <= max;
}

// Range Validation

/// Check if number is in range
pub fn in_range(value: int, min: int, max: int) -> bool {
    return value >= min && value <= max;
}

/// Check if value is positive
pub fn is_positive(value: int) -> bool {
    return value > 0;
}

/// Check if value is negative
pub fn is_negative(value: int) -> bool {
    return value < 0;
}

// Helper Functions

fn is_digit(c: string) -> bool {
    return c >= "0" && c <= "9";
}

fn is_letter(c: string) -> bool {
    return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z");
}

fn is_alphanumeric_char(c: string) -> bool {
    return is_digit(c) || is_letter(c);
}

fn is_alphanumeric_or_allowed(c: string) -> bool {
    return is_alphanumeric_char(c) || c == "." || c == "_" || c == "%" || c == "+" || c == "-";
}

fn is_alphanumeric_or_dot_hyphen(c: string) -> bool {
    return is_alphanumeric_char(c) || c == "." || c == "-";
}

fn is_hex_digit(c: string) -> bool {
    return is_digit(c) || (c >= "a" && c <= "f") || (c >= "A" && c <= "F");
}

// Sanitization

/// Sanitize string (remove HTML tags)
pub fn sanitize_html(value: string) -> string {
    var result: string = "";
    var in_tag: bool = false;
    
    for i in 0..value.length() {
        var c: string = value.char_at(i);
        
        if c == "<" {
            in_tag = true;
        } else if c == ">" {
            in_tag = false;
        } else if !in_tag {
            result = result + c;
        }
    }
    
    return result;
}

/// Sanitize string (escape special characters)
pub fn escape_html(value: string) -> string {
    var result: string = "";
    
    for i in 0..value.length() {
        var c: string = value.char_at(i);
        
        if c == "<" {
            result = result + "&lt;";
        } else if c == ">" {
            result = result + "&gt;";
        } else if c == "&" {
            result = result + "&amp;";
        } else if c == "\"" {
            result = result + "&quot;";
        } else if c == "'" {
            result = result + "&#39;";
        } else {
            result = result + c;
        }
    }
    
    return result;
}

/// Trim whitespace
pub fn trim(value: string) -> string {
    var start: int = 0;
    var end: int = value.length() - 1;
    
    while start <= end && is_whitespace(value.char_at(start)) {
        start = start + 1;
    }
    
    while end >= start && is_whitespace(value.char_at(end)) {
        end = end - 1;
    }
    
    if start > end {
        return "";
    }
    
    return string::substring(value, start, end + 1);
}

fn is_whitespace(c: string) -> bool {
    return c == " " || c == "\t" || c == "\n" || c == "\r";
}

/// Remove special characters
pub fn remove_special_chars(value: string) -> string {
    var result: string = "";
    for i in 0..value.length() {
        var c: string = value.char_at(i);
        if is_alphanumeric_char(c) || c == " " {
            result = result + c;
        }
    }
    return result;
}

/// Slugify string
pub fn slugify(value: string) -> string {
    var result: string = "";
    var last_was_dash: bool = false;
    
    for i in 0..value.length() {
        var c: string = string::to_lower(value.char_at(i));
        
        if is_alphanumeric_char(c) {
            result = result + c;
            last_was_dash = false;
        } else if c == " " || c == "_" || c == "-" {
            if !last_was_dash && result.length() > 0 {
                result = result + "-";
                last_was_dash = true;
            }
        }
    }
    
    // Remove trailing dash
    if result.length() > 0 && result.char_at(result.length() - 1) == "-" {
        result = string::substring(result, 0, result.length() - 1);
    }
    
    return result;
}
