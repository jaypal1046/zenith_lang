// Client-Side Router for Zenith Docs Site
// Handles client-side navigation and hydration
// Built with 100% Zenith Code

import 'dart:html' as html;
import 'dart:async';

/// Client-side router for SPA navigation
class Router {
  static final Router _instance = Router._internal();
  factory Router() => _instance;
  Router._internal();
  
  // Current route state
  String _currentPath = '/';
  Map<String, String> _params = {};
  Map<String, String> _query = {};
  
  // Route change listeners
  final List<Function(RouteChange)> _listeners = [];
  
  // Get current path
  String get currentPath => _currentPath;
  
  // Get route params (for dynamic routes like /docs/[slug])
  Map<String, String> get params => _params;
  
  // Get query parameters
  Map<String, String> get query => _query;
  
  /// Initialize router and handle browser back/forward
  void init() {
    // Listen to popstate for browser navigation
    html.window.onPopState.listen((event) {
      _handleNavigation(html.window.location.pathname);
    });
    
    // Handle initial load
    _handleNavigation(html.window.location.pathname);
  }
  
  /// Navigate to a new path
  void push(String path, {Map<String, dynamic>? state}) {
    if (path == _currentPath) return;
    
    html.history.pushState(state ?? {}, '', path);
    _handleNavigation(path);
  }
  
  /// Replace current history entry
  void replace(String path, {Map<String, dynamic>? state}) {
    html.history.replaceState(state ?? {}, '', path);
    _handleNavigation(path);
  }
  
  /// Go back in history
  void back() {
    html.history.back();
  }
  
  /// Go forward in history
  void forward() {
    html.history.forward();
  }
  
  /// Handle navigation
  void _handleNavigation(String path) {
    _currentPath = path;
    
    // Parse params and query from path
    final result = _parseRoute(path);
    _params = result['params'] ?? {};
    _query = result['query'] ?? {};
    
    // Notify listeners
    final routeChange = RouteChange(
      path: path,
      params: _params,
      query: _query,
    );
    
    for (final listener in _listeners) {
      listener(routeChange);
    }
    
    // Scroll to top
    html.document.documentElement?.scrollTo(0, 0);
  }
  
  /// Parse route to extract params and query
  Map<String, Map<String, String>> _parseRoute(String path) {
    final result = <String, Map<String, String>>{};
    
    // Split path and query
    final parts = path.split('?');
    final pathname = parts[0];
    final queryString = parts.length > 1 ? parts[1] : '';
    
    // Parse query parameters
    final query = <String, String>{};
    if (queryString.isNotEmpty) {
      for (final param in queryString.split('&')) {
        final keyValue = param.split('=');
        if (keyValue.length == 2) {
          query[keyValue[0]] = Uri.decodeComponent(keyValue[1]);
        }
      }
    }
    result['query'] = query;
    
    // Parse path params (simplified - real implementation would match route patterns)
    final params = <String, String>{};
    // Example: /docs/getting-started -> {slug: getting-started}
    if (pathname.startsWith('/docs/')) {
      params['slug'] = pathname.substring(6);
    }
    result['params'] = params;
    
    return result;
  }
  
  /// Subscribe to route changes
  void onChange(Function(RouteChange) listener) {
    _listeners.add(listener);
  }
  
  /// Unsubscribe from route changes
  void offChange(Function(RouteChange) listener) {
    _listeners.remove(listener);
  }
}

/// Route change event
class RouteChange {
  final String path;
  final Map<String, String> params;
  final Map<String, String> query;
  
  RouteChange({
    required this.path,
    required this.params,
    required this.query,
  });
}

/// Link component for client-side navigation
class Link {
  final String href;
  final String? className;
  final bool replace;
  final Widget? child;
  
  const Link({
    required this.href,
    this.className,
    this.replace = false,
    this.child,
  });
  
  /// Render link to HTML
  String render() {
    final classes = className != null ? 'class="$className"' : '';
    return '<a href="$href" $classes data-link="true">$child</a>';
  }
  
  /// Handle click event
  void onClick(html.MouseEvent event, Router router) {
    event.preventDefault();
    
    if (replace) {
      router.replace(href);
    } else {
      router.push(href);
    }
  }
}

/// Hydration engine - connects SSR HTML with client-side interactivity
class HydrationEngine {
  final Router router;
  
  HydrationEngine(this.router);
  
  /// Initialize hydration
  void hydrate() {
    print('Hydrating application...');
    
    // Initialize router
    router.init();
    
    // Setup event delegation for links
    _setupLinkHandling();
    
    // Restore component state
    _restoreState();
    
    print('Hydration complete!');
  }
  
  /// Setup global link handling
  void _setupLinkHandling() {
    html.document.onClick.listen((event) {
      // Find closest anchor tag
      html.AnchorElement? link = event.target as html.AnchorElement?;
      
      while (link != null && link.tagName != 'A') {
        link = link.parent as html.AnchorElement?;
      }
      
      if (link != null && link.dataset['link'] == 'true') {
        // Check if it's an internal link
        if (link.href.startsWith(html.window.location.origin)) {
          event.preventDefault();
          final path = link.href.substring(html.window.location.origin.length);
          router.push(path);
        }
      }
    });
  }
  
  /// Restore component state from session
  void _restoreState() {
    // In production, restore component state from sessionStorage
    try {
      final savedState = html.window.sessionStorage.getItem('zenith_state');
      if (savedState != null) {
        // Parse and restore state
        print('Restored state from session');
      }
    } catch (e) {
      print('Could not restore state: $e');
    }
  }
  
  /// Save component state to session
  void saveState(Map<String, dynamic> state) {
    try {
      html.window.sessionStorage.setItem('zenith_state', JSON.stringify(state));
    } catch (e) {
      print('Could not save state: $e');
    }
  }
}

/// Prefetch pages for faster navigation
class PrefetchManager {
  final Set<String> _prefetched = {};
  
  /// Prefetch a page
  void prefetch(String path) {
    if (_prefetched.contains(path)) return;
    
    print('Prefetching: $path');
    
    // Create link element to trigger browser prefetch
    final link = html.LinkElement()
      ..rel = 'prefetch'
      ..href = path
      ..as = 'document';
    
    html.document.head?.append(link);
    _prefetched.add(path);
  }
  
  /// Prefetch pages visible in viewport
  void prefetchVisible() {
    // Find all links with data-prefetch attribute
    final links = html.document.querySelectorAll('a[data-prefetch="true"]');
    
    for (final link in links) {
      if (link is html.AnchorElement) {
        prefetch(link.getAttribute('href') ?? '');
      }
    }
  }
}

// Global instances
final router = Router();
final hydration = HydrationEngine(router);
final prefetch = PrefetchManager();

/// Initialize client-side runtime
void main() {
  print('🌐 Zenith Client Runtime Starting...');
  
  // Start hydration
  hydration.hydrate();
  
  // Prefetch visible pages
  prefetch.prefetchVisible();
  
  print('Client runtime ready!');
}
