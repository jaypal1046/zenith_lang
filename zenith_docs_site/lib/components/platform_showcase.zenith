// Platform Showcase Component - Display supported platforms
// Built with 100% Zenith Code

import 'package:zenith_ui/zenith_ui.dart';

class PlatformShowcase extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return Container(
      padding: EdgeInsets.all(60),
      color: Color(0xFFF8FAFC),
      child: Column(
        children: [
          Text(
            'Build for Every Platform',
            style: TextStyle(fontSize: 42, fontWeight: FontWeight.bold),
          ),
          SizedBox(height: 16),
          Text(
            'Write once, run everywhere - Desktop, Mobile, Web, and WebAssembly',
            style: TextStyle(fontSize: 20, color: Colors.grey[600]),
          ),
          SizedBox(height: 48),
          Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              _buildPlatformCard(
                Icons.desktop_mac,
                'Desktop',
                'Windows, macOS, Linux',
                'Native performance with platform-specific UI',
              ),
              SizedBox(width: 24),
              _buildPlatformCard(
                Icons.phone_android,
                'Mobile',
                'iOS & Android',
                'Full access to native APIs and features',
              ),
              SizedBox(width: 24),
              _buildPlatformCard(
                Icons.public,
                'Web',
                'Modern Browsers',
                'SEO-friendly static pre-rendering',
              ),
              SizedBox(width: 24),
              _buildPlatformCard(
                Icons.memory,
                'WebAssembly',
                'WASM Runtime',
                'Near-native speed in the browser',
              ),
            ],
          ),
        ],
      ),
    );
  }

  Widget _buildPlatformCard(IconData icon, String title, String subtitle, String description) {
    return Card(
      elevation: 4,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
      child: Container(
        width: 280,
        padding: EdgeInsets.all(32),
        child: Column(
          children: [
            Container(
              width: 80,
              height: 80,
              decoration: BoxDecoration(
                gradient: LinearGradient(
                  colors: [Color(0xFF6366F1), Color(0xFF8B5CF6)],
                ),
                borderRadius: BorderRadius.circular(20),
              ),
              child: Icon(icon, color: Colors.white, size: 40),
            ),
            SizedBox(height: 24),
            Text(
              title,
              style: TextStyle(fontSize: 24, fontWeight: FontWeight.bold),
            ),
            SizedBox(height: 8),
            Text(
              subtitle,
              style: TextStyle(color: Color(0xFF6366F1), fontWeight: FontWeight-medium),
            ),
            SizedBox(height: 16),
            Text(
              description,
              style: TextStyle(color: Colors.grey[600], fontSize: 14),
              textAlign: TextAlign.center,
            ),
          ],
        ),
      ),
    );
  }
}
