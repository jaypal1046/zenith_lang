import std.io;
import std.math;

// -------------------------------------------------------------
// Fantasy Survival - Main Game Entry Point & Wave Spawner
// -------------------------------------------------------------

class FantasySurvivalGameApp() implements Scene {
    ArchmagePlayer mage;
    MonsterHordeGroup horde;
    int currentWave = 1;

    Void onCreate() {
        println("=========================================================");
        println("       ZENITH ENGINE - FANTASY SPELL SURVIVAL GAME        ");
        println("=========================================================");
        mage = ArchmagePlayer();
        horde = MonsterHordeGroup();

        println("[PBR Environment] Ancient Forest Sanctuary Loaded.");
        println("[Audio Engine] Orchestral Boss Battle BGM & Spell Sound Effects Ready.");
        println("[Particle System] High-Density Fire & Ice Magic Particle Systems Active.");
    }

    Void onUpdate(float dt) {
        println(concat("\n--- Wave ", concat(toString(currentWave), " Horde Combat Simulation ---")));
        mage.updateRegen(dt);
        horde.advanceHorde(0.0f, 0.0f, dt);

        mage.castFireball();
        mage.castIceNova();
    }
}

Void main() {
    FantasySurvivalGameApp game = FantasySurvivalGameApp();
    game.onCreate();
    game.onUpdate(0.016f);
    println("\n=========================================================");
    println(" FANTASY SURVIVAL GAME LOOP EXECUTED WITH 0 ERRORS!       ");
    println("=========================================================");
}
