{
  "Function Definition": {
    "prefix": "fn",
    "body": ["fn ${1:function_name}(${2:args}) -> ${3:ReturnType} {", "    $0", "}"],
    "description": "Create a new function definition"
  },
  "Struct Definition": {
    "prefix": "struct",
    "body": ["struct ${1:StructName} {", "    ${2:field}: ${3:Type},", "    $0", "}"],
    "description": "Create a new struct definition"
  },
  "Enum Definition": {
    "prefix": "enum",
    "body": ["enum ${1:EnumName} {", "    ${2:Variant1},", "    ${3:Variant2},", "    $0", "}"],
    "description": "Create a new enum definition"
  },
  "Impl Block": {
    "prefix": "impl",
    "body": ["impl ${1:StructName} {", "    fn ${2:method}(&self) {", "        $0", "    }", "}"],
    "description": "Create an implementation block"
  },
  "If Statement": {
    "prefix": "if",
    "body": ["if ${1:condition} {", "    $0", "}"],
    "description": "Create an if statement"
  },
  "If Else Statement": {
    "prefix": "ife",
    "body": ["if ${1:condition} {", "    $2", "} else {", "    $0", "}"],
    "description": "Create an if-else statement"
  },
  "Match Expression": {
    "prefix": "match",
    "body": ["match ${1:value} {", "    ${2:pattern} => ${3:result},", "    _ => $0", "}"],
    "description": "Create a match expression"
  },
  "For Loop": {
    "prefix": "for",
    "body": ["for ${1:item} in ${2:iterable} {", "    $0", "}"],
    "description": "Create a for loop"
  },
  "While Loop": {
    "prefix": "while",
    "body": ["while ${1:condition} {", "    $0", "}"],
    "description": "Create a while loop"
  },
  "Let Binding": {
    "prefix": "let",
    "body": ["let ${1:name}: ${2:Type} = ${3:value};"],
    "description": "Create a let binding"
  },
  "Mutable Let Binding": {
    "prefix": "letm",
    "body": ["let mut ${1:name}: ${2:Type} = ${3:value};"],
    "description": "Create a mutable let binding"
  },
  "Module Declaration": {
    "prefix": "mod",
    "body": ["module ${1:module_name} {", "    $0", "}"],
    "description": "Create a module declaration"
  },
  "Use Statement": {
    "prefix": "use",
    "body": ["use ${1:path}::${2:item};"],
    "description": "Create a use statement"
  },
  "Extern Block": {
    "prefix": "extern",
    "body": ["extern \"C\" {", "    fn ${1:function_name}(${2:args}) -> ${3:ReturnType};", "    $0", "}"],
    "description": "Create an extern block for FFI"
  },
  "Foreign Function": {
    "prefix": "foreign",
    "body": ["foreign lib \"${1:library_name}\" {", "    fn ${2:function_name}(${3:args}) -> ${4:ReturnType};", "    $0", "}"],
    "description": "Declare a foreign function from a dynamic library"
  },
  "Print Statement": {
    "prefix": "print",
    "body": ["println!(\"${1:message}\");"],
    "description": "Print a message to console"
  },
  "Return Statement": {
    "prefix": "ret",
    "body": ["return ${1:value};"],
    "description": "Return a value from function"
  }
}
