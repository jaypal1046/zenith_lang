import std.io;

class Calculator(Int start) {
    let value = start;
    let fval = 10.0;

    Void add(Int x) {
        value += x;
    }

    Void sub(Int x) {
        value -= x;
    }

    Void mul(Int x) {
        value *= x;
    }

    Void div(Int x) {
        value /= x;
    }

    Void addFloat(Float y) {
        fval += y;
    }
}

Void main() {
    println("Testing Unary and Compound Assignment Operators...");

    // 1. Test Unary Logical NOT (!)
    let t = true;
    let f = !t;
    println("t = " + t + ", !t = " + f);
    if (!f) {
        println("Logical NOT test 1 passed");
    } else {
        println("Logical NOT test 1 failed");
    }

    let not_f = !f;
    if (not_f) {
        println("Logical NOT test 2 passed");
    } else {
        println("Logical NOT test 2 failed");
    }

    // 2. Test Unary Negation (-)
    let x = 42;
    let neg_x = -x;
    println("x = " + x + ", -x = " + neg_x);
    if (neg_x == -42) {
        println("Negation test 1 passed");
    } else {
        println("Negation test 1 failed");
    }

    let y = 3.14;
    let neg_y = -y;
    println("y = " + y + ", -y = " + neg_y);

    // 3. Test Compound Assignment on Local Variables
    let a = 10;
    a += 5;
    println("a += 5 -> " + a); // should be 15
    a -= 3;
    println("a -= 3 -> " + a); // should be 12
    a *= 2;
    println("a *= 2 -> " + a); // should be 24
    a /= 4;
    println("a /= 4 -> " + a); // should be 6

    // 4. Test Compound Assignment on Class Fields
    let calc = Calculator(100);
    calc.add(50);
    println("calc.value after += 50: " + calc.value); // should be 150
    calc.sub(30);
    println("calc.value after -= 30: " + calc.value); // should be 120
    calc.mul(3);
    println("calc.value after *= 3: " + calc.value);   // should be 360
    calc.div(2);
    println("calc.value after /= 2: " + calc.value);   // should be 180

    calc.addFloat(5.5);
    println("calc.fval after += 5.5: " + calc.fval);   // should be 15.5
}
