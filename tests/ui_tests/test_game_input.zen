import std.io;

@library("builtin")
foreign "C" {
    Bool isKeyPressed(String key);
    Bool wasKeyPressed(String key);
    Bool wasKeyReleased(String key);
    Float getAxis(String negativeKey, String positiveKey);
    Float getMouseX();
    Float getMouseY();
}

interface Canvas {
    Void clear(String color);
    Void drawRect(Float x, Float y, Float w, Float h, String color);
    Void drawText(String text, Float x, Float y, String color);
    Void present();
}

class GameplayInputTestGame() {
    Float player_x = 12.0;
    Float player_y = 7.0;
    Float move_speed = 18.0;
    Float axis_x = 0.0;
    Float axis_y = 0.0;
    String player_color = "green";
    String status_text = "Use WASD or arrows. Tap Space to flash yellow.";

    Void init() {
        println("GameplayInputTestGame initialized");
    }

    Void update(Float dt) {
        axis_x = getAxis("a", "d");
        axis_y = getAxis("w", "s");

        if (isKeyPressed("ArrowLeft")) {
            axis_x = axis_x - 1.0;
        }
        if (isKeyPressed("ArrowRight")) {
            axis_x = axis_x + 1.0;
        }
        if (isKeyPressed("ArrowUp")) {
            axis_y = axis_y - 1.0;
        }
        if (isKeyPressed("ArrowDown")) {
            axis_y = axis_y + 1.0;
        }

        player_x = player_x + axis_x * move_speed * dt;
        player_y = player_y + axis_y * move_speed * dt;

        if (player_x < 0.0) {
            player_x = 0.0;
        }
        if (player_y < 0.0) {
            player_y = 0.0;
        }
        if (player_x > 74.0) {
            player_x = 74.0;
        }
        if (player_y > 20.0) {
            player_y = 20.0;
        }

        if (wasKeyPressed("Space")) {
            player_color = "yellow";
            status_text = "Space pressed this frame";
        }
        if (wasKeyReleased("Space")) {
            player_color = "green";
            status_text = "Space released this frame";
        }
    }

    Void draw(canvas: Canvas) {
        String axis_text = "Axis X: ";
        axis_text = axis_text + axis_x;
        axis_text = axis_text + ", Axis Y: ";
        axis_text = axis_text + axis_y;

        String mouse_x_text = "Mouse X: ";
        mouse_x_text = mouse_x_text + getMouseX();

        String mouse_y_text = "Mouse Y: ";
        mouse_y_text = mouse_y_text + getMouseY();

        canvas.clear("black");
        canvas.drawRect(player_x, player_y, 6.0, 3.0, player_color);
        canvas.drawText("Gameplay Input Test", 2.0, 1.0, "yellow");
        canvas.drawText(status_text, 2.0, 3.0, "white");
        canvas.drawText(axis_text, 2.0, 5.0, "cyan");
        canvas.drawText(mouse_x_text, 2.0, 7.0, "magenta");
        canvas.drawText(mouse_y_text, 2.0, 8.0, "magenta");
    }
}

Void main() {
    GameplayInputTestGame game = GameplayInputTestGame();
    game.run();
}
