import std.io;
import "../src/vault.zen";

class EditorApp() {
    String currentText = "";
    
    UI build() {
        return Column(
            Text("SecureVault Note Editor", fontWeight: "bold", color: "magenta"),
            Card(
                Text("Edit your secret note below:"),
                TextField(placeholder: "Start typing...", onChange: handleTextChange),
                Button("Done", onClick: handleDone),
                padding: 1
            )
        );
    }
    
    Void handleTextChange(String val) {
        setState {
            currentText = val;
        }
    }
    
    Void handleDone() {
        println("Editing finished. Note length: " + currentText.length());
    }
}

Void main() {
    EditorApp app = EditorApp();
    zenith::runInteractiveLoop(app);
}
