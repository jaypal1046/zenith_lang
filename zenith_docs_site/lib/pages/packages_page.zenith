// Packages Page - Package ecosystem and integration guide
// Built with 100% Zenith Code

import 'package:zenith_ui/zenith_ui.dart';
import '../components/navigation.dart';
import '../components/footer.dart';

class PackagesPage extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: Navigation(),
      body: SingleChildScrollView(
        child: Column(
          children: [
            _buildHeroSection(),
            _buildPackageBridges(),
            _buildGettingStarted(),
          ],
        ),
      ),
      footer: Footer(),
    );
  }

  Widget _buildHeroSection() {
    return Container(
      padding: EdgeInsets.all(60),
      decoration: BoxDecoration(
        gradient: LinearGradient(
          colors: [Color(0xFF6366F1), Color(0xFF8B5CF6)],
        ),
      ),
      child: Column(
        children: [
          Text(
            'Package Ecosystem',
            style: TextStyle(
              fontSize: 48,
              fontWeight: FontWeight.bold,
              color: Colors.white,
            ),
          ),
          SizedBox(height: 16),
          Text(
            'Access thousands of packages from Rust and Dart ecosystems',
            style: TextStyle(
              fontSize: 20,
              color: Colors.white.withOpacity(0.9),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildPackageBridges() {
    return Container(
      padding: EdgeInsets.all(60),
      child: Column(
        children: [
          Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              _buildBridgeCard(
                '🦀',
                'Rust Bridge',
                'zenith_rust',
                'Access the entire Rust crate ecosystem',
                [
                  'Zero-copy FFI bindings',
                  'Async/await support',
                  'Type-safe interfaces',
                  'Automatic binding generation',
                ],
                Color(0xFFDE9B48),
              ),
              SizedBox(width: 32),
              _buildBridgeCard(
                '🎯',
                'Dart Bridge',
                'zenith_dart',
                'Use Dart packages seamlessly',
                [
                  'Auto-generated bindings',
                  'Hot reload support',
                  'Null safety',
                  'Full ecosystem access',
                ],
                Color(0xFF00B4AB),
              ),
            ],
          ),
        ],
      ),
    );
  }

  Widget _buildBridgeCard(String emoji, String title, String packageName, String description, List<String> features, Color color) {
    return Card(
      elevation: 4,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
      child: Container(
        width: 500,
        padding: EdgeInsets.all(32),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                Text(emoji, style: TextStyle(fontSize: 48)),
                SizedBox(width: 16),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        title,
                        style: TextStyle(fontSize: 28, fontWeight: FontWeight.bold),
                      ),
                      Text(
                        packageName,
                        style: TextStyle(color: color, fontSize: 16, fontWeight: FontWeight.medium),
                      ),
                    ],
                  ),
                ),
              ],
            ),
            SizedBox(height: 20),
            Text(
              description,
              style: TextStyle(fontSize: 16, color: Colors.grey[700]),
            ),
            SizedBox(height: 24),
            ...features.map((feature) => Padding(
              padding: EdgeInsets.only(bottom: 12),
              child: Row(
                children: [
                  Icon(Icons.check_circle, color: Color(0xFF10B981), size: 20),
                  SizedBox(width: 12),
                  Text(feature, style: TextStyle(fontSize: 15)),
                ],
              ),
            )).toList(),
          ],
        ),
      ),
    );
  }

  Widget _buildGettingStarted() {
    return Container(
      padding: EdgeInsets.all(60),
      color: Color(0xFFF8FAFC),
      child: Column(
        children: [
          Text(
            'Getting Started',
            style: TextStyle(fontSize: 36, fontWeight: FontWeight.bold),
          ),
          SizedBox(height: 32),
          _buildExampleCard(
            'Using Rust Packages',
            '''
// Import the Rust bridge
import 'package:zenith_rust/zenith_rust.dart';

// Initialize Rust runtime
void main() {
  RustBridge.initialize();
  
  // Call a Rust function
  final result = await RustBridge.call('my_crate::my_function', args: [42]);
  print('Result from Rust: \$result');
}
''',
            Color(0xFFDE9B48),
          ),
          SizedBox(height: 24),
          _buildExampleCard(
            'Using Dart Packages',
            '''
// Import Dart packages through the bridge
import 'package:zenith_dart/zenith_dart.dart';
import 'package:http/http.dart' as http;

// Use Dart packages just like in Dart code
void fetchData() async {
  final response = await http.get(Uri.parse('https://api.example.com'));
  print('Response: \${response.body}');
}
''',
            Color(0xFF00B4AB),
          ),
        ],
      ),
    );
  }

  Widget _buildExampleCard(String title, String code, Color color) {
    return Container(
      padding: EdgeInsets.all(24),
      decoration: BoxDecoration(
        color: Color(0xFF1E293B),
        borderRadius: BorderRadius.circular(16),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Container(
                width: 12,
                height: 12,
                decoration: BoxDecoration(
                  color: color,
                  shape: BoxShape.circle,
                ),
              ),
              SizedBox(width: 12),
              Text(
                title,
                style: TextStyle(
                  color: Colors.white,
                  fontSize: 18,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ],
          ),
          SizedBox(height: 16),
          Container(
            padding: EdgeInsets.all(16),
            decoration: BoxDecoration(
              color: Colors.black.withOpacity(0.3),
              borderRadius: BorderRadius.circular(8),
            ),
            child: Text(
              code,
              style: TextStyle(
                fontFamily: 'monospace',
                color: Colors.white,
                fontSize: 14,
                height: 1.6,
              ),
            ),
          ),
        ],
      ),
    );
  }
}
