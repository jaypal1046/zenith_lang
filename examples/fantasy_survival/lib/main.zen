import std.io;
import std.math;

// -------------------------------------------------------------
// Fantasy Survival - Main Entry Point (lib/main.zen)
// -------------------------------------------------------------

class ArchmagePlayer() {
    String name = "Mage Zenith";
    float mana = 100.0f;

    Void castFireball() {
        println("[Spellcasting] Mage Zenith cast FIREBALL! Dealt 75 Explosive Damage!");
    }

    Void castIceNova() {
        println("[Spellcasting] Mage Zenith cast ICE NOVA! Frozen 10 Enemies in Area-of-Effect!");
    }
}

Void main() {
    println("=========================================================");
    println("       ZENITH ENGINE - FANTASY SPELL SURVIVAL GAME        ");
    println("=========================================================");
    ArchmagePlayer mage = ArchmagePlayer();
    mage.castFireball();
    mage.castIceNova();
    println("=========================================================");
}
