// pages/docs.zen - Documentation page  → route: /docs
import std.io;

class DocsPage() {
    String title = "Zenith Documentation";

    UI build() {
        return Column(
            Text(title, fontWeight: "bold", color: "cyan"),
            Card(
                Text("zenith serve", fontWeight: "bold", color: "yellow"),
                Text("Start the SSR web server with file-system routing:", color: "gray"),
                Text("  zenith serve ./myapp --port 3000", color: "green"),
                Text("  zenith serve pages/index.zen --port 8080", color: "green"),
                padding: 2
            ),
            Card(
                Text("Directory Structure", fontWeight: "bold", color: "yellow"),
                Text("myapp/", color: "white"),
                Text("  pages/", color: "cyan"),
                Text("    index.zen    →  /", color: "green"),
                Text("    about.zen   →  /about", color: "green"),
                Text("    docs.zen    →  /docs", color: "green"),
                Text("  public/", color: "cyan"),
                Text("    style.css   →  /style.css", color: "green"),
                Text("    logo.png    →  /logo.png", color: "green"),
                padding: 2
            )
        );
    }
}

Void main() {
    println("[SSR] Rendered: docs");
}
