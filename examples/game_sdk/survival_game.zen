import std.io;
import std.math;

// -------------------------------------------------------------
// Zenith Open-World Survival Example Game
// Demonstrates Procedural Generation, Day/Night Cycle, Weather & Crafting Systems
// -------------------------------------------------------------

class Inventory() {
    int woodCount = 0;
    int stoneCount = 0;
    int ironCount = 0;

    Void addItem(String item, int count) {
        if (item == "Wood") woodCount = woodCount + count;
        if (item == "Stone") stoneCount = stoneCount + count;
        if (item == "Iron") ironCount = ironCount + count;
        println(concat("[Inventory] Added ", concat(toString(count), concat(" ", item))));
    }

    bool craftAxe() {
        if (woodCount >= 5 && stoneCount >= 3) {
            woodCount = woodCount - 5;
            stoneCount = stoneCount - 3;
            println("[Crafting] Successfully crafted Stone Axe!");
            return true;
        }
        println("[Crafting] Not enough resources to craft Stone Axe!");
        return false;
    }
}

class SurvivalGameScene() implements Scene {
    Inventory playerInventory;
    float timeOfDay = 14.0f; // 2:00 PM
    String currentWeather = "Rainy";

    Void onCreate() {
        println("=================================================");
        println(" ZENITH ENGINE - OPEN-WORLD SURVIVAL DEMO GAME ");
        println("=================================================");
        playerInventory = Inventory();

        println("[Procedural Terrain] 2D/3D Perlin Noise Heightmap Generated.");
        println("[World Sim] Starting Time of Day: 14:00 (Sun Angle: 45°).");
        println("[World Sim] Active Weather Volume: Rainy (Fog Density: 0.05).");
    }

    Void onUpdate(float dt) {
        // Advance time of day
        timeOfDay = timeOfDay + dt * 0.1f;
        if (timeOfDay >= 24.0f) timeOfDay = 0.0f;

        // Gather & Craft
        playerInventory.addItem("Wood", 8);
        playerInventory.addItem("Stone", 5);
        playerInventory.craftAxe();

        println(concat("[World Sim] Time of Day: ", concat(toString(timeOfDay), " hours.")));
    }
}

Void main() {
    SurvivalGameScene survival = SurvivalGameScene();
    survival.onCreate();
    survival.onUpdate(0.016f);
    println("\n[Open-World Survival] World Simulation Loop Complete!");
}
