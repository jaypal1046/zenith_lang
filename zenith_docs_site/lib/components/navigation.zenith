// Navigation Component - Modern responsive navigation bar
// Built with 100% Zenith Code

import 'package:zenith_ui/zenith_ui.dart';

class Navigation extends StatelessWidget implements PreferredSizeWidget {
  @override
  Size get preferredSize => Size.fromHeight(70);

  @override
  Widget build(BuildContext context) {
    return AppBar(
      elevation: 0,
      backgroundColor: Colors.transparent,
      leading: Builder(
        builder: (context) => IconButton(
          icon: Icon(Icons.menu, color: Color(0xFF6366F1)),
          onPressed: () => Scaffold.of(context).openDrawer(),
        ),
      ),
      title: Row(
        children: [
          Container(
            width: 40,
            height: 40,
            decoration: BoxDecoration(
              gradient: LinearGradient(
                colors: [Color(0xFF6366F1), Color(0xFF8B5CF6)],
              ),
              borderRadius: BorderRadius.circular(8),
            ),
            child: Center(
              child: Text(
                'Z',
                style: TextStyle(
                  color: Colors.white,
                  fontSize: 24,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
          ),
          SizedBox(width: 12),
          Text(
            'Zenith',
            style: TextStyle(
              color: Color(0xFF1E293B),
              fontSize: 24,
              fontWeight: FontWeight.bold,
            ),
          ),
        ],
      ),
      actions: [
        _buildNavItem(context, 'Docs', '/docs'),
        _buildNavItem(context, 'Cookbook', '/cookbook'),
        _buildNavItem(context, 'Platforms', '/platforms'),
        _buildNavItem(context, 'Packages', '/packages'),
        SizedBox(width: 16),
        ElevatedButton.icon(
          onPressed: () {},
          icon: Icon(Icons.star, size: 20),
          label: Text('Star on GitHub'),
          style: ElevatedButton.styleFrom(
            backgroundColor: Color(0xFF6366F1),
            foregroundColor: Colors.white,
            padding: EdgeInsets.symmetric(horizontal: 20, vertical: 12),
            shape: RoundedRectangleBorder(
              borderRadius: BorderRadius.circular(8),
            ),
          ),
        ),
        SizedBox(width: 16),
      ],
    );
  }

  Widget _buildNavItem(BuildContext context, String label, String route) {
    final isActive = ModalRoute.of(context)?.settings.name == route;
    return Padding(
      padding: EdgeInsets.symmetric(horizontal: 4),
      child: TextButton(
        onPressed: () => Navigator.pushNamed(context, route),
        child: Text(
          label,
          style: TextStyle(
            color: isActive ? Color(0xFF6366F1) : Color(0xFF64748B),
            fontWeight: isActive ? FontWeight-semibold : FontWeight-medium,
            fontSize: 16,
          ),
        ),
      ),
    );
  }
}
