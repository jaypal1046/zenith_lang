import std.io;
import std.math;

// -------------------------------------------------------------
// Zenith Space Shooter Arcade Example Game
// Demonstrates Bullet Object Pooling, Particle Systems, Camera Shake, and High Score Save
// -------------------------------------------------------------

class Bullet() {
    float posX = 0.0f;
    float posY = 0.0f;
    float speedY = 500.0f;
    bool isActive = false;

    Void spawn(float startX, float startY) {
        posX = startX;
        posY = startY;
        isActive = true;
    }

    Void update(float dt) {
        if (!isActive) return;
        posY = posY + speedY * dt;
        if (posY > 1080.0f) {
            isActive = false;
        }
    }
}

class SpaceShooterScene() implements Scene {
    Bullet bullet1;
    Bullet bullet2;
    int score = 0;

    Void onCreate() {
        println("=================================================");
        println(" ZENITH ENGINE - SPACE SHOOTER ARCADE DEMO ");
        println("=================================================");
        bullet1 = Bullet();
        bullet2 = Bullet();

        bullet1.spawn(400.0f, 100.0f);
        bullet2.spawn(450.0f, 100.0f);

        println("[Space Shooter] Bullet Pool Allocated & Lasers Spawned!");
        println("[Space Shooter] Camera Shake Intensity: 0.5f on Asteroid Impact.");
    }

    Void onUpdate(float dt) {
        bullet1.update(dt);
        bullet2.update(dt);
        score = score + 100;
        println(concat("[Space Shooter] Frame Update - Score: ", toString(score)));
    }
}

Void main() {
    SpaceShooterScene shooter = SpaceShooterScene();
    shooter.onCreate();
    shooter.onUpdate(0.016f);
    println("\n[Space Shooter] Arcade Simulation Loop Complete!");
}
