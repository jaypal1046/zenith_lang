// Feature Grid Component - Display language features
// Built with 100% Zenith Code

import 'package:zenith_ui/zenith_ui.dart';

class FeatureGrid extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return Container(
      padding: EdgeInsets.all(60),
      child: Column(
        children: [
          Text(
            'Why Choose Zenith?',
            style: TextStyle(fontSize: 42, fontWeight: FontWeight.bold),
          ),
          SizedBox(height: 16),
          Text(
            'The only language that combines C++ speed, universal UI, and native AI',
            style: TextStyle(fontSize: 20, color: Colors.grey[600]),
          ),
          SizedBox(height: 48),
          GridView.count(
            crossAxisCount: 3,
            shrinkWrap: true,
            physics: NeverScrollableScrollPhysics(),
            mainAxisSpacing: 24,
            crossAxisSpacing: 24,
            children: [
              _buildFeatureItem(
                Icons.speed,
                'C++ Performance',
                'Transpiles to optimized C++17 for maximum execution speed',
                Color(0xFF10B981),
              ),
              _buildFeatureItem(
                Icons.devices,
                'Universal UI',
                'Build once, deploy to Desktop, Mobile, Web, and WASM',
                Color(0xFF6366F1),
              ),
              _buildFeatureItem(
                Icons.psychology,
                'Native AI',
                'Built-in agentic primitives for seamless AI integration',
                Color(0xFF8B5CF6),
              ),
              _buildFeatureItem(
                Icons.security,
                'Memory Safe',
                'Hybrid RC + GC memory management for safety and performance',
                Color(0xFFF59E0B),
              ),
              _buildFeatureItem(
                Icons.build,
                'Package Bridges',
                'Direct access to Rust crates and Dart packages',
                Color(0xFFEC4899),
              ),
              _buildFeatureItem(
                Icons.flash_on,
                'Hot Reload',
                'Instant feedback with compiler daemon and hot reload',
                Color(0xFF06B6D4),
              ),
            ],
          ),
        ],
      ),
    );
  }

  Widget _buildFeatureItem(IconData icon, String title, String description, Color color) {
    return Card(
      elevation: 2,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
      child: Padding(
        padding: EdgeInsets.all(24),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Container(
              width: 56,
              height: 56,
              decoration: BoxDecoration(
                color: color.withOpacity(0.1),
                borderRadius: BorderRadius.circular(12),
              ),
              child: Icon(icon, color: color, size: 28),
            ),
            SizedBox(height: 20),
            Text(
              title,
              style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
            ),
            SizedBox(height: 8),
            Text(
              description,
              style: TextStyle(color: Colors.grey[600], fontSize: 14, height: 1.5),
            ),
          ],
        ),
      ),
    );
  }
}
